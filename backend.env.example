# 형식만 보여주는 예시다. 실제 값은 깃에 절대 넣지 않는다.
# 진짜 값은 서버의 ~/deploy/backend.env 에만 있고, 그 파일은 chmod 600 이다.

SPRING_PROFILES_ACTIVE=prod

DB_HOST=<RDS 엔드포인트>
DB_PORT=3306
DB_NAME=<DB 이름>
DB_USERNAME=<계정>
DB_PASSWORD=<비밀번호 관리자 참조>

# S3 파일 저장소. 버킷 이름만 넣는다(ARN도 URL도 아니다).
# 자격증명 키는 여기 넣지 않는다 — EC2 인스턴스에 붙인 IAM 역할을 SDK가 알아서 줍는다.
S3_BUCKET=<버킷 이름>
# 리전은 기본값이 ap-northeast-2 다. 다른 리전이면만 적는다.
# AWS_REGION=ap-northeast-2

# JVM 옵션. 이미지 기본값(Dockerfile)과 같은 값이라 평소에는 없어도 된다.
# 이미지를 새로 빌드하지 않고 힙만 바꿔야 할 때 이 줄로 덮어쓴다.
# 서버의 backend.env 에는 실제로 이 줄이 들어가 있다 (t3.small 2GB 기준).
JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=128m
